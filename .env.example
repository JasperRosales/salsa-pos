# Copy to .env and adjust.

# The ETL pipeline's source CSV. salsa-pos appends one row per sale; the ETL
# extractor picks new rows up on its next run (every 30 seconds by default).
# Must be on the same machine as the ETL. Relative paths resolve against this
# project folder.
CSV_PATH=../isha-v2/etl-pipeline-microservice-setup/data/transactions.csv

# Local address only. Tailscale Serve publishes it to your tailnet over HTTPS
# (npm run serve:on), so nothing is exposed on the LAN or the internet.
HOST=127.0.0.1
PORT=3100
